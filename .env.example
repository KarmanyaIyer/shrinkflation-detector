# Copy to .env and fill in. Never commit .env.

# DeepSeek API key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# Kroger Public API credentials (https://developer.kroger.com)
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Store to track (8-digit Kroger locationId) and how to describe it on the site
KROGER_LOCATION_ID=
KROGER_LOCATION_LABEL=one Kroger store

# Postgres connection string
DATABASE_URL=postgresql+psycopg://shrink:shrink@localhost:5432/shrink

# OpenTelemetry. Leave the endpoint empty to disable export.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=shrinkflation-detector
# Public path the built site is served from. Must end with a slash.
VITE_BASE_PATH=/

# API base URL used by the browser. Relative paths are proxied to the backend by the dev server.
# In production point this at the API origin, for example https://api.example.com/api
VITE_API_BASE=/api

# Set to 1 to render fixture data instead of calling the API.
VITE_USE_FIXTURES=0

# Backend the dev server forwards /api requests to.
DEV_API_PROXY_TARGET=http://127.0.0.1:8000
